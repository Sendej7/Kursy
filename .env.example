# Skopiuj na `.env` i uzupełnij. Wszystkie zmienne są OPCJONALNE — bez nich aplikacja startuje,
# ale ficzery (płatności, OAuth, AI, prawdziwe maile) są wyłączone.
#
# `docker compose up -d` pobierze ten plik automatycznie.

# --- Klucz do podpisywania JWT (min 32 znaki). W prod: krypto-losowy. ---
JWT_SIGNING_KEY=dev-only-key-min-32-chars-please-change-me

# --- Adres frontu (używany w linkach w mailach + w GitHub OAuth callback). ---
APP_BASE_URL=http://localhost:5173

# --- Claude API (AI mentor + generowanie kursów). Bez klucza endpointy /api/ai/* zwracają stub. ---
CLAUDE_API_KEY=

# --- Stripe (płatności + faktury). Bez kluczy /api/billing/* zwraca 503. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Google OAuth. Bez ClientId przyciski Google ukryte. ---
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- GitHub OAuth. Bez kluczy przyciski GitHub ukryte. ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
VITE_GITHUB_CLIENT_ID=

# --- SMTP. Domyślnie idzie do `mailhog` z tego compose'a (UI: localhost:8025).
#     Dla prawdziwego SMTP (Mailgun/SES/SendGrid) podmień. ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@kursy.local

# --- Sentry (error tracking). Bez DSN logi tylko do konsoli; z DSN warningi i errory
#     leca tez do projektu Sentry. ---
SENTRY_DSN=
